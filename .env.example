# Application runtime
# In production (Docker image) NODE_ENV=production and PORT=8080 are already set.
NODE_ENV=development
PORT=3000
# Public URL of the site (used for robots.txt / sitemap.xml). Example: https://www.izcormedic.com
APP_URL=http://localhost:3000

# Gemini AI (optional: TDR analysis)
GEMINI_API_KEY=

# PostgreSQL / Drizzle
# REQUIRED in production: managed PostgreSQL connection string.
# Without it the app uses embedded PGlite in .data/, whose data is lost when a container restarts.
DATABASE_URL=
SQL_HOST=localhost
SQL_PORT=5432
SQL_DB_NAME=izcor_medic
SQL_USER=postgres
SQL_PASSWORD=postgres
SQL_ADMIN_USER=postgres
SQL_ADMIN_PASSWORD=postgres

# Optional: local override for frontend/legacy setups
# VITE_API_BASE_URL=http://localhost:3000
